#!/usr/bin/env bash
# Codon pre-commit hook: lint .specs/ if any spec files changed.
# Enable with:  git config core.hooksPath .githooks
set -euo pipefail

# Only run when spec files are part of this commit.
changed=$(git diff --cached --name-only --diff-filter=ACMR | grep -E '\.specs/.*\.spec\.md$|\.specs/.*\.toml$' || true)
if [ -z "$changed" ]; then
  exit 0
fi

SPEC_BIN="vendor/forge-spec/spec-cli/target/release/spec"
if [ ! -x "$SPEC_BIN" ]; then
  echo "pre-commit: building spec-cli (one-time)..." >&2
  ( cd vendor/forge-spec/spec-cli && cargo build --release --quiet ) || {
    echo "pre-commit: failed to build spec-cli — skipping spec lint" >&2
    exit 0
  }
fi

if ! "$SPEC_BIN" lint; then
  echo "" >&2
  echo "pre-commit: 'spec lint' failed. Fix the above before committing." >&2
  echo "  (To bypass for an emergency, use 'git commit --no-verify'.)" >&2
  exit 1
fi
